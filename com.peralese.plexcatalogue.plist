<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.peralese.plexcatalogue</string>

  <!-- Full path to the Python interpreter in your venv -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOUR_USERNAME/Projects/Plex_Catalogue/.venv/bin/python</string>
    <string>/Users/YOUR_USERNAME/Projects/Plex_Catalogue/run.py</string>
  </array>

  <!-- Working directory must be the project root so .env is found -->
  <key>WorkingDirectory</key>
  <string>/Users/YOUR_USERNAME/Projects/Plex_Catalogue</string>

  <!-- Start automatically at login -->
  <key>RunAtLoad</key>
  <true/>

  <!-- Restart if it crashes -->
  <key>KeepAlive</key>
  <true/>

  <!-- Log stdout / stderr -->
  <key>StandardOutPath</key>
  <string>/Users/YOUR_USERNAME/Projects/Plex_Catalogue/logs/stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USERNAME/Projects/Plex_Catalogue/logs/stderr.log</string>
</dict>
</plist>
